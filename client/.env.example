# StrangerConnect Client Environment Variables

# Backend WebSocket Signaling Server URL (Leave empty for dynamic localhost/LAN detection)
VITE_SOCKET_URL=http://localhost:8080

# PostHog Anonymous Product Analytics (Optional - Free Tier)
# Get your Project API Key from https://us.i.posthog.com/project/settings
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Frontend Error Diagnostics (Optional - Free Tier)
# Get your DSN from https://sentry.io/settings/projects/
VITE_SENTRY_DSN=
